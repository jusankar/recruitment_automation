# =========================
# Core Secrets
# =========================
OPENAI_API_KEY=replace_with_openai_key
NEXTAUTH_SECRET=replace_with_secure_secret

# =========================
# Docker Image Versioning
# =========================
IMAGE_REGISTRY=local
IMAGE_TAG=v1.0.0

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=interviewdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For external managed Postgres (Render/Neon/Supabase), append sslmode:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# =========================
# HireMatrixUI
# =========================
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_TALENT_API=http://localhost:8000
NEXT_PUBLIC_INTERVIEW_API=http://interviewaix:8001
NEXT_PUBLIC_APP_VERSION=v1.0.0

# Email provider config (HireMatrixUI / Nodemailer)
EMAIL_PROVIDER=gmail
EMAIL_FROM=

# Gmail mode
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMTP mode (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# =========================
# TalentMatchAI
# =========================
TALENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TALENT_APP_NAME=TalentMatchAI
TALENT_ENVIRONMENT=development
TALENT_LOG_LEVEL=INFO
CHROMA_PERSIST_DIR=/app/chroma_db
COLLECTION_NAME=resumes
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
TOP_K=20
SIMILARITY_THRESHOLD=0.7
MAX_BATCH_SIZE=100
MAX_RESUME_LENGTH=20000
UPLOAD_DIR=/app/uploads

# Gmail intake labels (TalentMatchAI)
GMAIL_MAX_RESULTS=20
GMAIL_RESUME_LABEL=Resume Inbox
GMAIL_PROCESSED_LABEL=Resume Received

# =========================
# InterviewAIx
# =========================
INTERVIEW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
